<?xml version="1.0"?>
<sdf version="1.9">
  <world name="campus_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><diffuse>0.66 0.69 0.66 1</diffuse></material></visual>
    </link></model>
    <!-- Visual-only flags flank the shared route start and finish at x=0, y=0. -->
    <model name="start_marker"><static>true</static><pose>-0.65 0 0.10 0 0 0</pose><link name="marker_link">
      <visual name="green_start"><geometry><cylinder><radius>0.12</radius><length>0.20</length></cylinder></geometry><material><diffuse>0.05 0.85 0.25 1</diffuse></material></visual>
    </link></model>
    <model name="finish_marker"><static>true</static><pose>0.65 0 0.10 0 0 0</pose><link name="marker_link">
      <visual name="red_finish"><geometry><cylinder><radius>0.12</radius><length>0.20</length></cylinder></geometry><material><diffuse>0.95 0.12 0.12 1</diffuse></material></visual>
    </link></model>
    <!-- Campus pathways and landscaped verge; thin surfaces are visual-only. -->
    <model name="campus_map_paths"><static>true</static><link name="path_visuals">
      <visual name="main_east_west_path"><pose>0 1.70 0.018 0 0 0</pose><geometry><box><size>9.0 1.65 0.025</size></box></geometry><material><diffuse>0.46 0.49 0.48 1</diffuse></material></visual>
      <visual name="south_entry_path"><pose>0 0.78 0.018 0 0 0</pose><geometry><box><size>1.65 2.05 0.025</size></box></geometry><material><diffuse>0.46 0.49 0.48 1</diffuse></material></visual>
      <visual name="upper_path_edge_south"><pose>0 0.83 0.020 0 0 0</pose><geometry><box><size>9.0 0.07 0.028</size></box></geometry><material><diffuse>0.77 0.72 0.58 1</diffuse></material></visual>
      <visual name="upper_path_edge_north"><pose>0 2.57 0.020 0 0 0</pose><geometry><box><size>9.0 0.07 0.028</size></box></geometry><material><diffuse>0.77 0.72 0.58 1</diffuse></material></visual>
      <visual name="west_grass_verge"><pose>-4.65 0 0.012 0 0 0</pose><geometry><box><size>1.25 8.0 0.02</size></box></geometry><material><diffuse>0.24 0.43 0.25 1</diffuse></material></visual>
      <visual name="east_grass_verge"><pose>4.65 0 0.012 0 0 0</pose><geometry><box><size>1.25 8.0 0.02</size></box></geometry><material><diffuse>0.24 0.43 0.25 1</diffuse></material></visual>
    </link></model>
    <!-- Four tree trunks are collision obstacles, positioned outside the route. -->
    <model name="tree_north_west"><static>true</static><pose>-4.45 3.15 0 0 0 0</pose><link name="tree">
      <collision name="trunk_collision"><pose>0 0 0.43 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.86</length></cylinder></geometry></collision>
      <visual name="trunk"><pose>0 0 0.43 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.86</length></cylinder></geometry><material><diffuse>0.34 0.20 0.10 1</diffuse></material></visual>
      <visual name="canopy"><pose>0 0 1.34 0 0 0</pose><geometry><sphere><radius>0.58</radius></sphere></geometry><material><diffuse>0.12 0.38 0.17 1</diffuse></material></visual>
      <visual name="canopy_highlight"><pose>0.20 0.03 1.55 0 0 0</pose><geometry><sphere><radius>0.34</radius></sphere></geometry><material><diffuse>0.18 0.48 0.21 1</diffuse></material></visual>
    </link></model>
