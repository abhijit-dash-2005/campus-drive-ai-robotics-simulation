<?xml version="1.0"?>
<sdf version="1.9">
  <model name="campus_robot">
    <!-- Spawn height is supplied by campus_sim.launch.py; keep model-local pose at zero. -->
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.12</ixx>
          <iyy>0.15</iyy>
          <izz>0.20</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.40 0.28 0.12</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.40 0.28 0.12</size></box></geometry>
        <material><diffuse>0.1 0.4 0.9 1</diffuse></material>
      </visual>
      <!-- Decorative car-style hood, cabin, windshield, bumper, and lamps. -->
      <visual name="car_hood">
        <pose>0.055 0 0.085 0 0 0</pose>
        <geometry><box><size>0.25 0.29 0.045</size></box></geometry>
        <material><diffuse>0.08 0.32 0.82 1</diffuse></material>
      </visual>
      <visual name="car_cabin">
        <pose>-0.045 0 0.17 0 0 0</pose>
        <geometry><box><size>0.19 0.235 0.13</size></box></geometry>
        <material><diffuse>0.05 0.18 0.34 1</diffuse></material>
      </visual>
      <visual name="front_windshield">
        <pose>0.055 0 0.17 0 0.20 0</pose>
        <geometry><box><size>0.025 0.205 0.105</size></box></geometry>
        <material><diffuse>0.30 0.78 0.92 1</diffuse></material>
      </visual>
      <visual name="front_bumper">
        <pose>0.215 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.32 0.045</size></box></geometry>
        <material><diffuse>0.08 0.08 0.10 1</diffuse></material>
      </visual>
      <visual name="left_headlight">
        <pose>0.194 0.092 0.035 0 0 0</pose>
        <geometry><box><size>0.025 0.055 0.035</size></box></geometry>
        <material><diffuse>1 0.88 0.22 1</diffuse></material>
      </visual>
      <visual name="right_headlight">
        <pose>0.194 -0.092 0.035 0 0 0</pose>
        <geometry><box><size>0.025 0.055 0.035</size></box></geometry>
        <material><diffuse>1 0.88 0.22 1</diffuse></material>
      </visual>
      <visual name="left_rear_light">
        <pose>-0.205 0.092 0.015 0 0 0</pose>
        <geometry><box><size>0.025 0.05 0.03</size></box></geometry>
        <material><diffuse>0.95 0.08 0.05 1</diffuse></material>
      </visual>
      <visual name="right_rear_light">
        <pose>-0.205 -0.092 0.015 0 0 0</pose>
        <geometry><box><size>0.025 0.05 0.03</size></box></geometry>
        <material><diffuse>0.95 0.08 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.17 -0.04 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.17 -0.04 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <!-- Positive DiffDrive wheel speed must roll the robot toward model +X. -->
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <!-- Match the left wheel axis so positive commands drive forward. -->
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <link name="lidar_link">
      <!-- Keep the scan plane above the car cabin so the LiDAR cannot hit its own shell. -->
      <pose>0 0 0.32 0 0 0</pose>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>

